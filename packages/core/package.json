{
  "name": "@select-lub/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "default": "./src/contracts.ts"
    },
    "./db": {
      "types": "./src/kernel/prisma/index.ts",
      "default": "./src/kernel/prisma/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./modules/*": {
      "types": "./src/modules/*/index.ts",
      "default": "./src/modules/*/index.ts"
    }
  },
  "scripts": {
    "postinstall": "prisma generate --schema prisma/schema",
    "test": "vitest run",
    "typecheck": "tsc --build && tsc --noEmit -p tsconfig.test.json",
    "db:ping": "tsx src/kernel/prisma/ping.ts",
    "db:generate": "prisma generate --schema prisma/schema",
    "db:migrate": "tsx src/kernel/prisma/migrate-deploy.ts",
    "db:reconcile-returns": "tsx prisma/reconcile-returns.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:scrub-live": "tsx prisma/scrub-live.ts",
    "db:worktree-env": "tsx src/kernel/prisma/worktree-env.ts",
    "tidsci:generate": "tsx src/kernel/clients/erp-mock/mock/tidsci/generate.ts",
    "motul:demo": "tsx scripts/motul/demo.ts",
    "motul:capture-demo-fleet": "tsx scripts/motul/capture-demo-fleet.ts",
    "motul:capture-brazil-motor-catalogue": "tsx scripts/motul/capture-brazil-motor-catalogue.ts",
    "tecfil:demo": "tsx scripts/tecfil/demo.ts",
    "tecfil:capture-demo-fleet": "tsx scripts/tecfil/capture-demo-fleet.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.29",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.112.4",
    "ai": "^7.0.51",
    "fastify": "^5.5.0",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.0",
    "unpdf": "1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "9.9.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "prisma": "^6.19.3",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
