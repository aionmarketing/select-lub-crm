{
  "name": "select-lub-crm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @select-lub/web dev",
    "dev:web:antigravity": "pnpm --filter @select-lub/web dev --mode antigravity",
    "dev:api": "pnpm --filter @select-lub/api dev",
    "dev:worker": "pnpm --filter @select-lub/worker dev",
    "dev": "concurrently -n api,web -c blue,green -k \"pnpm:dev:api\" \"pnpm:dev:web\"",
    "dev:full": "concurrently -n api,web,worker -c blue,green,yellow -k \"pnpm:dev:api\" \"pnpm:dev:web\" \"pnpm:dev:worker\"",
    "db:migrate": "pnpm --filter @select-lub/core db:migrate",
    "db:seed": "pnpm --filter @select-lub/core db:seed",
    "db:migrate-then-seed": "pnpm db:migrate && pnpm db:seed",
    "db:reconcile-returns": "pnpm --filter @select-lub/core db:reconcile-returns",
    "db:scrub-live": "pnpm --filter @select-lub/core db:scrub-live",
    "db:worktree-env": "pnpm --filter @select-lub/core db:worktree-env",
    "lint": "eslint .",
    "gen:grants": "tsx scripts/gen-grants.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude \"**/*.live.test.ts\" && vitest run --no-file-parallelism \".live.test.\"",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:web:antigravity": "pnpm --filter @select-lub/web test --mode antigravity",
    "test:e2e": "pnpm --filter @select-lub/e2e test",
    "test:e2e:live": "pnpm --filter @select-lub/e2e test:live",
    "test:e2e:tours": "pnpm --filter @select-lub/e2e test:tours",
    "test:e2e:tours:disconnected": "pnpm --filter @select-lub/e2e test:tours:disconnected",
    "tours:supabase:start": "pnpm --filter @select-lub/e2e tours:supabase:start",
    "tours:supabase:stop": "pnpm --filter @select-lub/e2e tours:supabase:stop",
    "test:e2e:remote": "pnpm --filter @select-lub/e2e test:remote",
    "deploy:api": "node fly-deploy.mjs api",
    "deploy:api:antigravity": "node fly-deploy.mjs api:antigravity",
    "deploy:worker": "node fly-deploy.mjs worker",
    "typecheck": "tsc --build && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p apps/api/tsconfig.test.json && tsc --noEmit -p apps/worker/tsconfig.test.json && tsc --noEmit -p apps/web/tsconfig.test.json && tsc --noEmit -p packages/core/tsconfig.test.json && tsc --noEmit -p packages/shared-types/tsconfig.test.json && tsc --noEmit -p apps/e2e/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "1.10.0",
    "@vitest/coverage-v8": "catalog:",
    "concurrently": "^10.0.5",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "prettier": "^3.6.2",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.68.0",
    "vitest": "catalog:"
  }
}
