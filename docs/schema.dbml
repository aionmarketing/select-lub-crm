Ref: conversation.whatsapp_connection_id > whatsapp_connection.id
// conversation.customer_id NÃO é FK no Prisma

Ref: message.conversation_id > conversation.id
Ref: message.whatsapp_connection_id > whatsapp_connection.id
Ref: message.sent_by_user_id > user.id

Ref: outbox_message.conversation_id > conversation.id

Ref: customer.unit_id > unit.id [delete: set null]
Ref: customer.merged_into_id > customer.id [delete: set null]

Ref: customer_phone.customer_id > customer.id [delete: cascade]
Ref: customer_email.customer_id > customer.id [delete: cascade]

Ref: vehicle.customer_id > customer.id [delete: restrict]

Ref: customer_field_sync.customer_id > customer.id [delete: cascade]
Ref: vehicle_field_sync.vehicle_id > vehicle.id [delete: cascade]
Ref: customer_reconciliation_pending.customer_id > customer.id [delete: cascade]
Ref: vehicle_reconciliation_pending.vehicle_id > vehicle.id [delete: cascade]

Ref: service.customer_id > customer.id [delete: restrict]
Ref: service.vehicle_id > vehicle.id [delete: set null]
Ref: service.unit_id > unit.id [delete: restrict]
