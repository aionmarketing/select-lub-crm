Ref: vehicle_return.archived_by_user_id > user.id [delete: set null]

Ref: return_reminder_message.vehicle_return_id > vehicle_return.id [delete: cascade]
Ref: return_reminder_message.template_id > template.id [delete: set null]
Ref: return_reminder_message.created_by_user_id > user.id [delete: restrict]

Ref: follow_up_closed_entry.unit_id > unit.id [delete: cascade]
Ref: follow_up_closed_entry.conversation_id > conversation.id [delete: cascade]
Ref: follow_up_closed_entry.closed_by_user_id > user.id [delete: restrict]

Ref: scheduled_message.customer_id > customer.id
Ref: scheduled_message.conversation_id > conversation.id
Ref: scheduled_message.service_id > service.id
Ref: scheduled_message.return_reminder_message_id > return_reminder_message.id [delete: cascade]
Ref: scheduled_message.template_id > template.id
Ref: scheduled_message.interval_rule_id > interval_rule.id
Ref: scheduled_message.created_by_user_id > user.id
Ref: service_scheduled_attribution.service_id > service.id
Ref: service_scheduled_attribution.scheduled_message_id > scheduled_message.id
Ref: service_conversation_attribution.service_id > service.id
Ref: service_conversation_attribution.conversation_id > conversation.id

Ref: business_event.customer_id > customer.id
