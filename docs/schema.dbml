Ref: service_field_sync.service_id > service.id

Ref: cadastro_prefill_job.conversation_id > conversation.id [delete: cascade]
Ref: cadastro_prefill_suggestion.conversation_id > conversation.id [delete: cascade]
Ref: cadastro_prefill_suggestion.job_id > cadastro_prefill_job.id [delete: restrict]

Ref: tag.unit_id > unit.id [delete: restrict]
Ref: template.unit_id > unit.id [delete: restrict]
Ref: conversation_tag.conversation_id > conversation.id [delete: cascade]
Ref: conversation_tag.tag_id > tag.id [delete: restrict]
Ref: conversation_tag.assigned_by_user_id > user.id
Ref: conversation_tag.removed_by_user_id > user.id

Ref: vehicle_owner.vehicle_id > vehicle.id
Ref: vehicle_owner.customer_id > customer.id

Ref: customer_merge.base_customer_id > customer.id
Ref: customer_merge.mergee_customer_id > customer.id
Ref: customer_merge.executed_by_user_id > user.id

Ref: oil_quote.customer_id > customer.id
Ref: oil_quote.vehicle_id > vehicle.id
Ref: oil_quote.conversation_id > conversation.id
Ref: oil_quote.created_by_user_id > user.id
Ref: oil_quote_line.oil_quote_id > oil_quote.id
Ref: oil_quote_line.catalog_item_id > catalog_item.id
Ref: catalog_lubricant.catalog_item_id - catalog_item.id
Ref: catalog_filter.catalog_item_id - catalog_item.id

Table attribution_rule {
  id          varchar     [pk, note: 'Identificador interno da regra global de atribuição.']
  version     int         [not null, unique, note: 'Versão crescente. A maior é a vigente. Mutar window_days é proibido — insere-se nova versão.']
  window_days int         [not null, note: 'Janela em dias corridos (padrão 30 na versão 1).']
  created_at  timestamptz [not null, default: `now()`, note: 'Quando esta versão foi criada.']
  updated_at  timestamptz [not null, note: 'Prisma exige updated_at; a janela desta versão não muda.']

  Note: 'IMPL GitHub #61. Regra global (não por unidade). A migration insere a versão 1 com 30 dias.'
}

Table service_scheduled_attribution {
  id                   varchar     [pk, note: 'Identificador interno do par serviço↔mensagem programada.']
  service_id           varchar     [not null, note: 'OS Omie atribuída (REP-11).']
  scheduled_message_id varchar     [not null, note: 'Mensagem SENT âncora.']
  rule_version         int         [not null, note: 'Versão da regra vigente na primeira inserção. Não é reescrita se a janela mudar.']
  created_at           timestamptz [not null, default: `now()`, note: 'Quando o par foi estabelecido.']

  indexes {
    (service_id, scheduled_message_id) [unique, note: 'No máximo um par por âncora. O serviço conta uma vez no relatório.']
  }

  Note: 'IMPL REP-11 / AC-REP-09. Associação temporal, não causalidade.'
}

Table service_conversation_attribution {
  id              varchar     [pk, note: 'Identificador interno do par serviço↔conversa.']
  service_id      varchar     [not null, note: 'OS Omie do cliente da conversa (REP-12).']
  conversation_id varchar     [not null, note: 'Conversa nova com customer_id, âncora first_inbound_at.']
  rule_version    int         [not null, note: 'Versão da regra vigente na primeira inserção.']
  created_at      timestamptz [not null, default: `now()`, note: 'Quando o par foi estabelecido.']

  indexes {
    (service_id, conversation_id) [unique, note: 'No máximo um par serviço+conversa.']
  }

  Note: 'IMPL REP-12 / AC-REP-09. Associação temporal, não causalidade.'
}

Ref: vehicle_return.vehicle_id > vehicle.id [delete: cascade]
Ref: vehicle_return.source_service_id > service.id [delete: cascade]
