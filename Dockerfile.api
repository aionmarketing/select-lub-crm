# syntax=docker/dockerfile:1
# Build context: repository root.
#   docker build -f Dockerfile.api -t select-lub-api .
#   fly deploy . --config apps/api/fly.toml

FROM node:22-bookworm-slim AS builder
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@11.23.0 --activate
# prisma generate (postinstall) reads DATABASE_URL from the schema; this value
# is not copied into the runner stage.
ENV DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
RUN pnpm install --frozen-lockfile
ARG VITE_API_BASE=
ARG VITE_SUPABASE_URL=
ARG VITE_SUPABASE_ANON_KEY=
ARG VITE_MVP_LOGIN_EMAIL=
ARG VITE_MVP_LOGIN_PASSWORD=
# Build identity. VITE_UI_VARIANT picks the SPA composition here (Vite reads a
# process env var ahead of any .env file, so no --mode is needed) and is echoed
# by the API's /health so a caller can tell the two published origins apart.
# GIT_COMMIT is declared only in the runner stage: nothing here reads it, and an
# ARG that changes every deploy would invalidate the build layer below.
ARG VITE_UI_VARIANT=
ENV VITE_API_BASE=$VITE_API_BASE
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_MVP_LOGIN_EMAIL=$VITE_MVP_LOGIN_EMAIL
ENV VITE_MVP_LOGIN_PASSWORD=$VITE_MVP_LOGIN_PASSWORD
ENV VITE_UI_VARIANT=$VITE_UI_VARIANT
RUN pnpm --filter @select-lub/web build \
  && pnpm --filter @select-lub/api exec tsc --build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY --from=builder --chown=node:node /app /app
# Build args do not cross stages, and the API process reads both at request
# time to answer /health. GIT_COMMIT cannot be derived inside the build:
# .dockerignore drops .git.
ARG GIT_COMMIT=
ARG VITE_UI_VARIANT=
ENV GIT_COMMIT=$GIT_COMMIT
ENV VITE_UI_VARIANT=$VITE_UI_VARIANT
ENV HOST=0.0.0.0
ENV PORT=3000
ENV NODE_ENV=production
EXPOSE 3000
USER node
# node image entrypoint would treat .bin/tsx as a Node module; invoke the CLI file.
CMD ["node", "apps/api/node_modules/tsx/dist/cli.mjs", "apps/api/src/index.ts"]
