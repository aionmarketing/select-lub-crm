POSTGRES_USER=selectlub
POSTGRES_PASSWORD=selectlub
POSTGRES_DB=selectlub
DATABASE_URL=postgresql://selectlub:selectlub@127.0.0.1:5433/selectlub
# Migrate/direct connection. Local Compose can reuse DATABASE_URL. On Supabase,
# this is the direct URI (not the pooler). Fly machines never run migrations.
# DIRECT_URL=
# Optional. Uncomment after creating selectlub_test (apps/api/test/README.md).
# Never the same URL as DATABASE_URL — tests truncate this database.
# DATABASE_URL_TEST=postgresql://selectlub:selectlub@127.0.0.1:5433/selectlub_test

# Evolution API v2 — hosted instance (e.g. WhatsEvolution). The repo no longer ships a local
# Evolution stack; `docker compose up -d` starts CRM Postgres only.
# AUTHENTICATION_API_KEY comes from the hosted panel. EVOLUTION_WEBHOOK_SECRET: `openssl rand -hex 32`.
# Pairing still needs "syncFullHistory": true on POST /instance/create — see docs/poc-evolution-baileys.md.
AUTHENTICATION_API_KEY=replace-with-hosted-instance-api-key
EVOLUTION_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32
# Public HTTPS URL the Evolution host can POST to, plus /webhooks/evolution (not host.docker.internal).
# Local dev: a tunnel to the worker loopback (e.g. `cloudflared tunnel --url http://127.0.0.1:3001`).
# Production: the Fly worker owns the hosted instance's webhook — registering a local/tunnel URL over it stops production ingest.
EVOLUTION_WEBHOOK_URL=
# Remote Evolution API v2 origin (no trailing slash).
SERVER_URL=https://your-evolution-host.example.com
WORKER_PORT=3001
# Ingest retry interval (failed/stale webhook_event). Outbox drain uses WORKER_OUTBOX_POLL_MS.
WORKER_HEARTBEAT_MS=30000
# Outbox poll: drain queued attendant text until empty or 50 claims/tick. Independent of ingest retry.
WORKER_OUTBOX_POLL_MS=1000
# Claimed outbox rows older than this (worker crash/restart) become failed with send_outcome_unknown, never queued. Keep above the 120000 ms media send limit.
WORKER_OUTBOX_CLAIM_TIMEOUT_MS=180000
# Opt-in. Unset/false (default pnpm dev:worker) does not page Evolution REST history.
# Set to 1 to import pre-CRM 1:1 chats once at worker start (re-runnable, no webhook_event rows).
# Leave unset in demo. The worker also refuses the import when any Message.origin=SEED exists.
# WORKER_HISTORY_BACKFILL=1
# Unencoded panel name; spaces are allowed. Worker and API percent-encode the path.
EVOLUTION_INSTANCE_NAME=Select Lub
# Worker bind address. Unset defaults to 127.0.0.1 (loopback) so the local
# tunnel path stays on loopback. Fly sets WORKER_HOST=0.0.0.0.
WORKER_HOST=
# WhatsApp media is fetch-on-demand. The CRM does not archive attachments.
# Viewing needs a connected Evolution instance. Keep webhook base64: false.
# API rejects files larger than 16 MiB before the outbox row is created.

# Where the Motul and Tecfil HTTP clients send their requests. Both APIs are
# free and neither takes a key -- Tecfil's chavePerfil is a public tenant id --
# so blanking a credential cannot keep a test run off them. Redirecting the host
# is the only seam there is. Leave both empty in every real deployment; a test
# harness sets them to a loopback that answers nothing, which is what makes
# "no request leaves for Motul or Tecfil" a configured property rather than an
# accident of an incomplete fixture.
MOTUL_BASE_URL=
# Circuit breaker: after this many consecutive exhausted-retry failures, Motul calls fail fast
# (as `unavailable`) for the cool-down, and then one probe decides whether it is back.
# MOTUL_BREAKER_FAILURES=3
# MOTUL_BREAKER_COOLDOWN_MS=600000
TECFIL_BASE_URL=

# Internal runMotulAgent helper and the Tecfil option picker (not required for
# Motul or Tecfil HTTP lookups themselves). With OPENAI_API_KEY empty the picker
# makes no model call, never guesses, and research records a vehicle whose Tecfil
# name needs disambiguation as Tecfil `unavailable`, retried in the background
# (background-oil-research D12), not `unmatched`. On the worker.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional model override for the Tecfil option picker only. Empty falls back to
# OPENAI_MODEL, then to the Motul agent's default model.
TECFIL_PICKER_MODEL=
# Milliseconds one Tecfil pick may take before it is aborted and recorded as a failure
# (Tecfil `unavailable`, retried). Default 60000: the picker runs only in background
# research on the worker, so no quote waits on it (background-oil-research D2, D12).
# TECFIL_PICKER_TIMEOUT_MS=60000

# Oil-spec research (viscosity + service-fill liters from retrieved sources, the selectors, the
# escalation read and the web search): every model call is made by background research and the
# manual reading on the WORKER (background-oil-research). A quote calls no provider, so the api
# needs none of these. They use OPENAI_API_KEY above and the Responses API; empty OPENAI_API_KEY
# means no research call at all: the research runner and the manual reading claim nothing and log
# `no_key`, and the rest of the worker runs. Never commit a real key.
# The endpoint every research call goes to (the Responses API under it), no trailing slash needed.
# Empty uses OpenAI's own, https://api.openai.com/v1; the AI SDK reads the same variable. Set it
# only for a gateway or a local fake, never to point production at another provider.
# OPENAI_BASE_URL=https://api.openai.com/v1
# The model (switch-oil-research-to-openai). The model id is a setting, not a constant. The
# duration estimate's keys are computed from the process env, so OIL_RESEARCH_MODEL and
# OIL_RESEARCH_REASONING_EFFORT must be set on the api AND the worker together, or on neither.
# OIL_RESEARCH_MODEL=gpt-6.1-sol
#
# Reasoning effort (D1): one setting for every research call — extraction, passage and link
# selection, escalation, the web search's calls — sent as `reasoning.effort`. For gpt-6.1-sol:
# none | low | medium | high | xhigh. Default medium; a value the model does not accept (or a typo)
# sends the default and is logged once.
# OIL_RESEARCH_REASONING_EFFORT=medium
# Every call is streamed (D6) and aborted at this ceiling, ms (or by its run's budget). There is no
# idle timer: OpenAI documents no keep-alive while a model reasons.
# OIL_RESEARCH_CALL_TIMEOUT_MS=240000
# The limits above, WEB_SEARCH_TIMEOUT_MS and OIL_RESEARCH_UNKNOWN_CALL_USD follow the model and
# effort unless set. A model or effort with no measured row runs on the placeholder row, and the
# worker logs it at start-up.
# The output cap of one call, tokens, reasoning included: a reply cut here is a failure, not a
# partial answer. Measured on the benchmark: the largest reply used under 6,000.
# OIL_RESEARCH_MAX_OUTPUT_TOKENS=25000
#
# Passage selection (D4, D22): long texts are narrowed to the windows around their oil lines,
# within this many characters, and the model may answer up to this many line ranges.
# OIL_SELECTOR_MAX_CHARS=12000
# OIL_SELECTOR_MAX_RANGES=4
#
# Spend (D3, D5). A call the server accepted that reported no usage (aborted, or cut) is charged
# this, USD: a 25,000-token output reservation at US$ 10/M.
# OIL_RESEARCH_UNKNOWN_CALL_USD=0.25
# OIL_RESEARCH_MODEL_PRICES (JSON, USD per million tokens) adds or overrides a list price:
#   {"openai:gpt-6.1-sol": {"input": 2, "cachedInput": 0.1, "output": 10}}
# A model with no entry is charged conservatively, at OIL_RESEARCH_UNPRICED_MODEL_USD_PER_MTOK_*
# (cached input as input), and its usage is marked priced by fallback, so the cap errs safe.
# Money settings accept only a number >= 0 written with a dot; anything else is logged and the
# default is used.
# OIL_RESEARCH_MODEL_PRICES=
# OIL_RESEARCH_UNPRICED_MODEL_USD_PER_MTOK_INPUT=5
# OIL_RESEARCH_UNPRICED_MODEL_USD_PER_MTOK_OUTPUT=15
#
# Background oil research (background-oil-research, worker only). OFF unless exactly "true":
# a seeded development database must not research the demo fleet on someone's key. Production
# switches it on in apps/worker/fly.toml. The test suites pin it off whatever this file says.
# OIL_RESEARCH_ENABLED=false
# The runner's tick and the sweep's (which also keeps the worker's heartbeat), ms.
# OIL_RESEARCH_TICK_MS=10000
# OIL_RESEARCH_SWEEP_MS=60000
# A vehicle is queued once unchanged this long; a backfill claim only this long after the last
# run finished; a found manual is waited for this long (30 min: room for a download retry, 2026-09-27).
# OIL_RESEARCH_SETTLE_MS=120000
# OIL_RESEARCH_BACKFILL_PACE_MS=60000
# OIL_RESEARCH_MANUAL_WAIT_MS=1800000
# A run's ceiling, ms; unset follows the model row: 2700000 (45 min) on the placeholder row.
# OIL_RESEARCH_RUN_TIMEOUT_MS=
# Not settings: the dialog's "entre X e Y minutos" uses the last 200 runs per path (P25–P90)
# once there are 20, and until then the defaults task 1.13 measured on 2026-09-27 — search
# 1–5 min, manual 1–6 min, and P50(search) 60 s for the queue term (estimate.ts, D14).
# A refused key or an exhausted balance, or this many outages in a row on different
# identities, pauses research for OIL_RESEARCH_PROVIDER_PAUSE_MS.
# OIL_RESEARCH_PROVIDER_PAUSE_MS=900000
# OIL_RESEARCH_OUTAGE_BREAKER=3
# OIL_RESEARCH_MAX_ATTEMPTS=3
# The Motul Oil Advisor counts as degraded once it has failed without an answer, continuously, this
# long (ms; 6 h). A degraded Motul no longer makes a research run incomplete nor feeds the outage
# breaker; every run still calls it, and its first answer ends the state (owner, 2026-10-07).
# MOTUL_DEGRADED_AFTER_MS=21600000
# The daily budget, USD, America/Sao_Paulo day. It holds only the backfill: research someone is
# waiting on (a quote, a refetch, a registration, a manual upgrade) is never held by it, though its
# spend counts toward the day's total. Parsed strictly; 0 stops only the backfill.
# OIL_RESEARCH_DAILY_BUDGET_USD=2.00

# Escalation read when two authoritative sources disagree on an oil spec (prompt.md
# "Model routing"): one read over ALL the passages at once, accepted only within the values
# the sources already stated. Defaults to the research model and effort; override either to
# reconcile on another OpenAI model. No OPENAI_API_KEY = no escalation = conflicting_sources to
# the attendant, which is what prompt.md says to do rather than guess.
# ESCALATION_MODEL=
# ESCALATION_EFFORT=

# Web search fallback for the oil spec (web-search-source-adapter). Runs ONLY when no
# local adapter returned a source of tier 1-3, so a fixture or a Motul answer costs
# nothing extra. ON by default: set WEB_SEARCH_ENABLED=false to switch it off entirely
# (no search, no fetch; research falls back to whatever the local adapters found, and a
# `no_spec` it records is marked "not searched"). Since background-oil-research the search
# runs only inside a research run on the WORKER, so these overrides belong there; the api
# reads only WEB_SEARCH_MISS_TTL_HOURS (below).
#
# The search is OpenAI's own `web_search` tool on the research model, with the same
# OPENAI_API_KEY: there is no second key and no provider setting. The tool returns the sources it
# consulted (`web_search_call.action.sources`) and the code, not the model, decides which of them
# is read: the blocklist (packages/core/fixtures/oil-source-blocklist.json) rejects a domain
# before any classification, and the model classifies each page it finds (manufacturer manual,
# manufacturer technical, licensed database, lubricant-maker guide, aftermarket catalog) while
# code maps that class to the tier; the model never picks a tier number.
#
# COST. gpt-6.1-sol lists at US$ 2.00 in / 0.10 cached / 10.00 out per million tokens, and a
# search action costs US$ 0.01. Measured 2026-10-12: about US$ 0.07-0.12 per car. An `open_page`
# action is charged the same fee until OpenAI's billing for it is confirmed
# (WEB_SEARCH_BILL_PAGE_ACTIONS=false makes it free).
# WEB_SEARCH_ENABLED=true
# The tool-call cap asked of one search response. OpenAI treats it as SOFT (the benchmark saw 2
# calls for a cap of 1, 4 for 3): the code counts what happened and never trusts the cap.
# WEB_SEARCH_MAX_SEARCHES=3
# How much context the tool reads per call: low | medium | high.
# WEB_SEARCH_CONTEXT_SIZE=medium
# WEB_SEARCH_BILL_PAGE_ACTIONS=true
# Per-search budget, inside one research run. The timeout is enforced ON the call, not merely read before it.
# WEB_SEARCH_MAX_FETCHES=3
# The search's wall clock, the outer bound of every call inside it.
# WEB_SEARCH_TIMEOUT_MS=300000
# Reads vs attempts (oil-quote-retrieval-hardening D1): WEB_SEARCH_MAX_FETCHES caps the pages
# actually READ (their text reaches the extractor); WEB_SEARCH_MAX_ATTEMPTS caps the URLs
# TRIED, so a dead link or a PDF refused by its headers spends an attempt, not a read.
# WEB_SEARCH_MAX_ATTEMPTS=8
# A search that found nothing usable is remembered per identity (make, year, model, version)
# for this many hours and not bought again; the attendant's refetch still searches. 0 turns the
# memory off. The api reads it too, to re-open a no-source identity once the window has passed
# (background-oil-research D10): keep the api's and the worker's the same.
# WEB_SEARCH_MISS_TTL_HOURS=168
# The fee per search tool call the search log's costUsd is computed at, USD. Token prices come
# from the model's list price above.
# WEB_SEARCH_PRICE_PER_CALL=0.01

# Manufacturer manuals (ingest-harvested-manuals, GitHub #77). The worker reads the PDF manuals
# the oil-spec web search records, in the background, one per tick: ON by default (the owner
# approved background ingestion), so once deployed it downloads recorded manuals on its own.
# MANUAL_INGESTION_ENABLED=false is the kill switch. Text only: nothing is rendered.
# MANUAL_INGESTION_ENABLED=true
# WORKER_MANUAL_INGEST_MS=60000
# Hard limits per document. Measured 2026-09-25 on the recorded candidates (median 4.3 MB,
# max 14.5 MB); page count and durations are logged per document to check the rest.
# MANUAL_MAX_BYTES=41943040
# MANUAL_MAX_PAGES=600
# MANUAL_FETCH_TIMEOUT_MS=60000
# MANUAL_PARSE_TIMEOUT_MS=60000
# Text caps (characters) and the parser's memory. On Linux the parse runs in a child under
# `ulimit -v` of MANUAL_PARSE_MEMORY_MB of address space: node reserves about 768 of it, so
# 1024 leaves about 256 for the parse. The worker VM needs 1 GB (apps/worker/fly.toml);
# raise the two together.
# MANUAL_MAX_PAGE_CHARS=50000
# MANUAL_MAX_TEXT_CHARS=5000000
# MANUAL_PARSE_HEAP_MB=256
# MANUAL_PARSE_MEMORY_MB=1024
# How many manuals one vehicle identity may queue (the best by D1: model named, year, .com.br).
# MANUALS_PER_IDENTITY=2
# Reading a stored manual (quotes/read-manuals): how many prefiltered pages the passage selector
# sees. The reading uses OPENAI_API_KEY on the worker; without it the job claims nothing and logs that
# it is waiting, so readings stay pending (and spend none of their three attempts) until it is set.
# A reading runs under the research limits above (no fixed timeout of its own), counts toward
# OIL_RESEARCH_DAILY_BUDGET_USD, and the manuals a waiting research needs are read first
# (background-oil-research D11, D13, D20).
# MANUAL_PAGES_TO_SELECTOR=6

# Omie HTTP adapter. Leave empty locally so tests keep the fake adapter.
# CI MUST keep both unset — suites use the in-memory fake and must not open
# sockets to app.omie.com.br. Set only in vault / Fly secrets, never commit values.
# Mock opt-in (default off): OMIE_MOCK=1 uses the seeded mock when credentials are absent.
# Credentials always win over the mock flag.
# Worker startup one-shot pull (default off): WORKER_OMIE_PULL=1
# Incremental poll (default off): WORKER_OMIE_POLL=1 calls Omie periodically.
# Interval: WORKER_OMIE_POLL_MS (default 3600000).
OMIE_APP_KEY=
OMIE_APP_SECRET=
# OMIE_MOCK=1
# OMIE_MOCK_DATASET=tidsci
# OMIE_MOCK_TIDSCI_PATH=.local/tidsci-omie-dataset.json
# TID_ARCHIVE_DATABASE_URL=
# WORKER_OMIE_PULL=1
# WORKER_OMIE_POLL=1
# WORKER_OMIE_POLL_MS=3600000

# Plate lookup (MVP). APIBRASIL_BEARER_TOKEN spends prepaid credit. Unset with
# no PLACAS_MOCK leaves POST /plate-lookups unavailable; the vehicle form stays
# manual. Credentials win over PLACAS_MOCK=1.
# APIBRASIL_BEARER_TOKEN=
# PLACAS_MOCK=1
# Post-MVP fallback (API Placas / wdapi2.com.br). The factory ignores this
# token; do not set it on Fly. The adapter lives in packages/core/src/kernel/clients/placas un-wired.
# API_PLACAS_TOKEN sits in the request URL — never log it.
# API_PLACAS_TOKEN=

# Supabase Auth is on. Prisma reads CRM tables; keep the PostgREST Data API off.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Publishable/anon key (same value as VITE_SUPABASE_ANON_KEY in the SPA)
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
# API only — auth.admin.createUser. Never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Auth user UUIDs after creating attendant-a / attendant-b in the dashboard (not passwords).
# Each value MUST be that Auth user's uuid. Fastify loads UserUnit rows from
# local Postgres by the uuid on the verified token. A mismatch (or unset)
# still auto-logs in, then 403s every unit-scoped route; the SPA shell still renders.
# SEED_USER_A_ID=
# SEED_USER_B_ID=

# db:seed refuses any DATABASE_URL host that is not loopback, and prints the
# host it writes to on every run. Set this to 1 only when you deliberately mean
# to seed a remote database — a fresh deployed environment, or a disposable
# preview database. It writes the demo dataset by default and upserts on top of
# whatever rows are already there, so on an instance holding real data the new
# rows land alongside them rather than replacing them.
# SEED_ALLOW_REMOTE=1

# SPA (apps/web) — same URL and publishable/anon key. Never the service-role key.
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=
# Local Vite defaults to /api (dev proxy to :3000). Production image builds with
# an empty value so same-origin requests go to /conversations on the api app.
# VITE_API_BASE=
# SPA auto-logs in; does not show a login form. Password stays out of git.
VITE_MVP_LOGIN_EMAIL=
VITE_MVP_LOGIN_PASSWORD=

# Opt-in Playwright live Programar mensagem (`pnpm test:e2e:live`). Never CI.
# The script sets E2E_LIVE_SCHEDULE=1. At most one WhatsApp text to
# 19 00000-0002 (5519000000002). Stop any other worker (`pnpm dev:worker`) on
# the same DB first. Skip unless the flag is 1 and DATABASE_URL is local. Fail if
# the instance is not CONNECTED, or if DATABASE_URL is remote without
# LIVE_TESTS_ALLOW_REMOTE=1. Missing CRM row for 5519000000002 is created (no send).
# E2E_LIVE_SCHEDULE=1
# LIVE_TESTS_ALLOW_REMOTE=1

# Build-time UI variant: `cursor` (default) or `antigravity`. Set by
# `.env.antigravity` when the SPA is started with `--mode antigravity`; there is
# no need to set it here. Anything that is not exactly `antigravity` is `cursor`.
# VITE_UI_VARIANT=
#
# On a published image both of the following are Docker build args, not runtime
# values you set here — `pnpm deploy:api` / `deploy:api:antigravity` /
# `deploy:worker` pass them. GIT_COMMIT is the SHA the image was built from and
# is echoed by `GET /health` (`unknown` when the image was built without it);
# VITE_UI_VARIANT there also picks which SPA composition the bundle gets, since
# Vite reads a process env var ahead of any .env file.
# GIT_COMMIT=
